# ============================================================
# LFRMS Frontend — Local Environment Variables
# Replace placeholder values with your Supabase project credentials
# ============================================================

# Supabase — get from https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Backend API URL (local dev)
VITE_API_BASE_URL=http://localhost:4000/api

# App metadata
VITE_APP_NAME=LFRMS
VITE_APP_VERSION=0.1.0
VITE_DEFAULT_LOCALE=id
